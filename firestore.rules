rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // DentaFlow Clinic - Zero-UI Machine Account Security Rules
    // =========================================================================
    // Only the authenticated machine account registered for this clinic device
    // is authorized to read and write clinical data. The clinic end-user has no
    // direct cloud identity or cloud dashboard access, ensuring complete isolation.
    // =========================================================================

    function isMachineAuthenticated() {
      return request.auth != null && 
             (request.auth.token.firebase.sign_in_provider == 'custom' || 
              request.auth.token.role == 'clinic_machine' ||
              request.auth.token.email.matches('.*@clinic-machines[.]internal'));
    }

    function isClinicAuthorized(clinicId) {
      return isMachineAuthenticated() && 
             (request.auth.token.clinicId == clinicId || request.auth.uid == clinicId);
    }

    // Clinic-level isolated partition
    match /clinics/{clinicId} {
      allow read, write: if isClinicAuthorized(clinicId);

      // Sub-collections: patients, appointments, charts, invoices
      match /{allClinicCollections=**} {
        allow read, write: if isClinicAuthorized(clinicId);
      }
    }

    // Direct synchronization collections (when syncing root entities)
    match /sync_events/{eventId} {
      allow create: if isMachineAuthenticated() && request.resource.data.machineUid == request.auth.uid;
      allow read, update, delete: if isMachineAuthenticated() && resource.data.machineUid == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
